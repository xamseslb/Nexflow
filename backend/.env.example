APP_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be a dedicated LOGIN role granted hub_api, never postgres or service_role.
DATABASE_URL=postgresql+psycopg://hub_runtime:PASSWORD@HOST:5432/postgres?sslmode=require
# Used only by Alembic / administrative bootstrap, never the running API.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=["http://localhost:8087","http://127.0.0.1:8087"]
# Separate restricted worker LOGIN role granted hub_worker.
WORKER_DATABASE_URL=
